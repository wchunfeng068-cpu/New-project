{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "styles.css",
      "use": "@vercel/static"
    },
    {
      "src": "script.js",
      "use": "@vercel/static"
    },
    {
      "src": "shared-shell.js",
      "use": "@vercel/static"
    },
    {
      "src": "shared-inquiry.js",
      "use": "@vercel/static"
    },
    {
      "src": "mockups/product-center-preview.html",
      "use": "@vercel/static"
    },
    {
      "src": "mockups/product-detail-preview.html",
      "use": "@vercel/static"
    },
    {
      "src": "mockups/solution-preview.html",
      "use": "@vercel/static"
    },
    {
      "src": "mockups/market-preview.html",
      "use": "@vercel/static"
    },
    {
      "src": "mockups/company-presence-preview.html",
      "use": "@vercel/static"
    },
    {
      "src": "mockups/company-presence-preview.js",
      "use": "@vercel/static"
    },
    {
      "src": "mockups/assets/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "images/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "videos/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
