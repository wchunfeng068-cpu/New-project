{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/index.html", "has": [{ "type": "query", "key": "lang", "value": "zh" }], "destination": "/zh/", "statusCode": 301 },
    { "source": "/index.html", "has": [{ "type": "query", "key": "lang", "value": "es" }], "destination": "/es/", "statusCode": 301 },
    { "source": "/index.html", "has": [{ "type": "query", "key": "lang", "value": "hi" }], "destination": "/hi/", "statusCode": 301 },
    { "source": "/", "has": [{ "type": "query", "key": "lang", "value": "zh" }], "destination": "/zh/", "statusCode": 301 },
    { "source": "/products/", "has": [{ "type": "query", "key": "lang", "value": "zh" }], "destination": "/zh/products/", "statusCode": 301 },
    { "source": "/product-detail/", "has": [{ "type": "query", "key": "lang", "value": "zh" }], "destination": "/zh/product-detail/", "statusCode": 301 },
    { "source": "/solutions/", "has": [{ "type": "query", "key": "lang", "value": "zh" }], "destination": "/zh/solutions/", "statusCode": 301 },
    { "source": "/market/", "has": [{ "type": "query", "key": "lang", "value": "zh" }], "destination": "/zh/market/", "statusCode": 301 },
    { "source": "/about/", "has": [{ "type": "query", "key": "lang", "value": "zh" }], "destination": "/zh/about/", "statusCode": 301 },
    { "source": "/", "has": [{ "type": "query", "key": "lang", "value": "es" }], "destination": "/es/", "statusCode": 301 },
    { "source": "/products/", "has": [{ "type": "query", "key": "lang", "value": "es" }], "destination": "/es/products/", "statusCode": 301 },
    { "source": "/product-detail/", "has": [{ "type": "query", "key": "lang", "value": "es" }], "destination": "/es/product-detail/", "statusCode": 301 },
    { "source": "/solutions/", "has": [{ "type": "query", "key": "lang", "value": "es" }], "destination": "/es/solutions/", "statusCode": 301 },
    { "source": "/market/", "has": [{ "type": "query", "key": "lang", "value": "es" }], "destination": "/es/market/", "statusCode": 301 },
    { "source": "/about/", "has": [{ "type": "query", "key": "lang", "value": "es" }], "destination": "/es/about/", "statusCode": 301 },
    { "source": "/", "has": [{ "type": "query", "key": "lang", "value": "hi" }], "destination": "/hi/", "statusCode": 301 },
    { "source": "/products/", "has": [{ "type": "query", "key": "lang", "value": "hi" }], "destination": "/hi/products/", "statusCode": 301 },
    { "source": "/product-detail/", "has": [{ "type": "query", "key": "lang", "value": "hi" }], "destination": "/hi/product-detail/", "statusCode": 301 },
    { "source": "/solutions/", "has": [{ "type": "query", "key": "lang", "value": "hi" }], "destination": "/hi/solutions/", "statusCode": 301 },
    { "source": "/market/", "has": [{ "type": "query", "key": "lang", "value": "hi" }], "destination": "/hi/market/", "statusCode": 301 },
    { "source": "/about/", "has": [{ "type": "query", "key": "lang", "value": "hi" }], "destination": "/hi/about/", "statusCode": 301 },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.luggage-dc.com"
        }
      ],
      "destination": "https://luggage-dc.com/$1",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "dc-luggage.com"
        }
      ],
      "destination": "https://luggage-dc.com/$1",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.dc-luggage.com"
        }
      ],
      "destination": "https://luggage-dc.com/$1",
      "statusCode": 301
    },
    {
      "source": "/mockups/product-center-preview.html",
      "destination": "/products/",
      "statusCode": 301
    },
    {
      "source": "/mockups/product-detail-preview.html",
      "destination": "/product-detail/",
      "statusCode": 301
    },
    {
      "source": "/mockups/solution-preview.html",
      "destination": "/solutions/",
      "statusCode": 301
    },
    {
      "source": "/mockups/market-preview.html",
      "destination": "/market/",
      "statusCode": 301
    },
    {
      "source": "/mockups/company-presence-preview.html",
      "destination": "/about/",
      "statusCode": 301
    }
  ],
  "trailingSlash": true
}
